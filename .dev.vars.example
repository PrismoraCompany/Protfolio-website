# Copy to .dev.vars for local `npm run dev`. NEVER commit .dev.vars.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_EMAIL=prismorawebs@gmail.com
# Optional custom secret for the 60s rotating code (defaults to ADMIN_PASSWORD)
# ADMIN_CODE_KEY=your-custom-code-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=prismorawebs@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=prismorawebs@gmail.com
# CONTACT_TO can be a single email or multiple emails separated by commas, semicolons or spaces:
CONTACT_TO=prismorawebs@gmail.com, another-admin@gmail.com
# SMTP_SECURE=true   # only if your provider uses implicit TLS on a port other than 465
